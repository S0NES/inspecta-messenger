# ============================================================================
# inspecta-messenger/.env.prod — copie para .env.prod na VPS e preencha.
#   cp .env.prod.example .env.prod && nano .env.prod
#
# No profile `prod` os três *_WEBHOOK_SECRET são OBRIGATÓRIOS (sem default) —
# ausentes = boot falha. As API keys dos brokers têm default vazio (cai em mock
# por canal), mas em produção preencha todas.
# NUNCA commitar .env.prod.
# ============================================================================

# --- Roteamento / Traefik --------------------------------------------------
API_HOST=api.seudominio.com.br
HOOKS_HOST=hooks.seudominio.com.br
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Banco (OBRIGATÓRIO) ---------------------------------------------------
DATABASE_URL=jdbc:postgresql://inspecta-postgres-ostetc:5432/inspecta
DATABASE_USER=inspecta
DATABASE_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- RabbitMQ (OBRIGATÓRIO) ------------------------------------------------
RABBITMQ_HOST=inspecta-rabbitmq-i6kk2u
RABBITMQ_PORT=5672
RABBITMQ_USER=inspecta
RABBITMQ_PASSWORD=MESMA_SENHA_DO_INFRA_ENV

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Inspecta <noreply@seudominio.com.br>
# OBRIGATÓRIO em prod — valida a assinatura do webhook (esquema Svix), sem ele o boot falha.
# Copie o "Signing Secret" do endpoint de webhook no painel da Resend. Formato: whsec_<base64>.
# A verificação usa svix-id / svix-timestamp / svix-signature (HMAC-SHA256) com janela anti-replay de ~5min.
RESEND_WEBHOOK_SECRET=

# --- SMS (Infobip) ---------------------------------------------------------
INFOBIP_API_KEY=
# OBRIGATÓRIO em prod.
# TODO: header (X-Hub-Signature: sha256=<hex>) e algoritmo NÃO confirmados contra o produto real
# da Infobip — confirmar antes de ativar webhooks de SMS. SMS está fora do caminho crítico (adapter stub).
INFOBIP_WEBHOOK_SECRET=

# --- Push (Expo) -----------------------------------------------------------
EXPO_ACCESS_TOKEN=
# OBRIGATÓRIO em prod — "webhook secret" gerado por `eas webhook:create`.
# Verificação: header expo-signature = sha1=<hex>, HMAC-SHA1 do corpo cru com o secret (bytes UTF-8).
EXPO_WEBHOOK_SECRET=

# --- Assinatura / Pagamento (webhooks de terceiros) ----------------------
# O inspecta-messenger é a borda pública única de webhook (arquitetura.md §Auth). Verificação
# fail-closed: sem o segredo, todo webhook do provider correspondente é rejeitado com 401
# — e no profile prod o boot nem sobe (fail-fast).
#
# Autentique: a Autentique assina o corpo cru com HMAC-SHA256 e envia o hex no header
# x-autentique-signature. Este é o segredo do webhook (definido ao cadastrar o endpoint no
# painel Autentique). URL do webhook: https://<HOOKS_HOST>/v1/webhooks/assinatura/autentique.
# A assinatura é validada ANTES do parse; o payload autenticado é aplicado direto (sem pull).
AUTENTIQUE_WEBHOOK_SECRET=
#
# O inspecta-messenger também é quem monta+envia o createDocument e baixa o PDF assinado (broker Autentique).
SIGNATURE_BROKER=autentique
AUTENTIQUE_API_KEY=
AUTENTIQUE_API_URL=https://api.autentique.com.br/v2/graphql
# ausente/"false" = produção (chamada real); "true" = sandbox (não consome créditos).
AUTENTIQUE_SANDBOX=false
# AbacatePay: o "Secret" definido ao criar o webhook no painel AbacatePay. A AbacatePay o
# envia como query param ?webhookSecret=... na URL do webhook. Esta é a ÚNICA camada de
# autenticidade do webhook AbacatePay — o inspecta-worker não revalida assinatura nenhuma.
ABACATEPAY_WEBHOOK_SECRET=

# --- Runtime ---------------------------------------------------------------
IMAGE_TAG=latest
MESSENGER_MEM_LIMIT=768m
MESSENGER_JAVA_OPTS=-XX:MaxRAMPercentage=70
TZ=America/Sao_Paulo
