# Messenger environment configuration (local development)
# Copy this file to .env and fill in the values for your local environment
# This file is automatically .gitignored — never commit actual credentials

# Messaging provider credentials (optional in test profile, required in prod)
RESEND_API_KEY=
RESEND_FROM=Inspecta <noreply@example.com>
INFOBIP_API_KEY=
EXPO_ACCESS_TOKEN=

# Webhook secrets for incoming webhooks
# Resend: Svix signing secret, format whsec_<base64> (svix-id/svix-timestamp/svix-signature, HMAC-SHA256).
RESEND_WEBHOOK_SECRET=
# Infobip: UNVERIFIED scheme (X-Hub-Signature: sha256=<hex>) — confirm before enabling SMS webhooks.
INFOBIP_WEBHOOK_SECRET=
# Expo: expo-signature header, sha1=<hex>, HMAC-SHA1 of the raw body with the secret (UTF-8).
EXPO_WEBHOOK_SECRET=

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/inspecta
DATABASE_USER=inspecta
DATABASE_PASSWORD=inspecta

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=inspecta
RABBITMQ_PASSWORD=inspecta
