<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>br.com.vistoria</groupId>
  <artifactId>inspecta-messenger</artifactId>
  <version>0.1.0</version>
  <name>inspecta-messenger</name>
  <description>Inspecta - Mensageria: consome q.notify e envia email/sms/whatsapp/push. Banco (templates/entregas) via inspecta-core.</description>

  <properties>
    <java.version>21</java.version>
    <lombok.version>1.18.46</lombok.version>
    <jacoco.version>0.8.13</jacoco.version>
    <!-- Cobertura medida em 2026-08-20: 93.69%, suite verde (156 testes).
         Ja acima da meta, entao o piso e a propria meta de 0.85. -->
    <jacoco.line.minimum>0.85</jacoco.line.minimum>
    <awssdk.version>2.51.1</awssdk.version>
  </properties>

  <!-- BOM da AWS SDK v2, so pra gerenciar a versao do modulo s3 abaixo (nenhum outro modulo
       awssdk e usado). Sem isso o s3 puxaria transitivos com versoes desalinhadas entre si. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${awssdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

     <dependency>
        <groupId>com.inspecta</groupId>
        <artifactId>inspecta-core</artifactId>
        <!-- SNAPSHOT: sempre o inspecta-core mais novo do Reposilite (updatePolicy=always
             no <repository> de snapshots abaixo). Nao precisa mais subir versao aqui a
             cada classe/metodo novo no inspecta-core — so num marco de quebra de API. -->
        <version>1.3.0-SNAPSHOT</version>
    </dependency>

    <!-- Webhooks de broker + actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Render de template: mesma sintaxe {{var}} do Handlebars do notify Node -->
    <dependency>
      <groupId>com.github.jknack</groupId>
      <artifactId>handlebars</artifactId>
      <version>4.4.0</version>
    </dependency>

    <!-- FileStorage S3 real (br.com.vistoria.messenger.storage.S3FileStorage). Versao gerenciada
         pelo BOM importado acima. Path-style addressing (S3Configuration) e sempre configurado
         explicitamente em S3FileStorage — o SDK nao infere isso so por endpointOverride (licao
         do T7.2 historico), self-host MinIO/R2 quebra sem esse switch. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Reposilite: repositório Maven interno rodando como serviço Docker no Dokploy
       (imagem dzikoysk/reposilite, ver DEPLOY_DOKPLOY.md). É de lá que o inspecta-core
       é baixado — nem submodule, nem clonar o repo lado a lado. Troque o host pelo
       domínio real assim que ele existir. -->
  <repositories>
    <repository>
      <id>inspecta-reposilite</id>
      <url>https://maven.inspecta.viniciusscarabelli.tech/releases</url>
    </repository>
    <repository>
      <id>inspecta-reposilite-snapshots</id>
      <url>https://maven.inspecta.viniciusscarabelli.tech/snapshots</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled><updatePolicy>always</updatePolicy></snapshots>
    </repository>
  </repositories>

  <build>
    <plugins>
      <!-- Cobertura de teste. `mvn test` gera target/site/jacoco/index.html;
           `mvn verify` aplica o piso abaixo e falha o build se a cobertura cair.
           O piso e um catraca: fica no patamar atual para impedir regressao, e sobe
           deliberadamente em direcao a meta de 0.85. Nao coloque a meta aqui antes de
           a cobertura alcanca-la, ou o build nasce vermelho e o piso vira ruido. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
